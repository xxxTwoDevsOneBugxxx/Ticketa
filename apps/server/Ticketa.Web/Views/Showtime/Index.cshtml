@model IEnumerable<Showtime>
<div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body gap-4">
        <div class="flex items-center justify-between border-b border-base-300 pb-3">
            <h2 class="card-title">Showtimes</h2>
            <div class="flex items-center gap-2">
                <div class="tl-view-tabs" id="viewToggle" role="tablist">
                    <button type="button" class="tl-view-tab is-active" role="tab" aria-selected="true" data-view="table">Table</button>
                    <button type="button" class="tl-view-tab" role="tab" aria-selected="false" data-view="timeline">Timeline</button>
                    <div class="tl-view-underline" aria-hidden="true"></div>
                </div>
                <button onclick="openModal('createForm', '/showtime/upsert')" class="btn btn-primary">Create New +</button>
            </div>
        </div>

        <div id="tableView">
            <table id="DataTable" class="w-full border-separate border-spacing-y-4">
                <thead class="hidden">
                    <tr>
                        <th>Showtimes</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < 5; i++)
                    {
                        <tr class="animate-pulse">
                            <td class="p-0 border-0 bg-transparent align-top">
                                <div class="border border-base-300 bg-base-100 rounded-xl overflow-hidden shadow-sm mb-4">
                                    <div class="flex items-center gap-4 p-4">
                                        <div class="w-12 h-16 bg-base-300 rounded shrink-0"></div>
                                        <div class="flex-1 space-y-2.5 min-w-0">
                                            <div class="h-5 w-48 bg-base-300 rounded"></div>
                                            <div class="h-3.5 w-28 bg-base-300 rounded"></div>
                                        </div>
                                        <div class="h-7 w-28 rounded-full bg-base-300 shrink-0"></div>
                                        <div class="w-5 h-5 rounded bg-base-300 shrink-0"></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="timelineView" class="hidden">
        </div>
    </div>
</div>
<input type="checkbox" id="modal" class="modal-toggle" />

<div class="modal shadow-2xl" id="modal-wrapper" role="dialog" aria-modal="true">
    <div class="modal-box w-11/12 max-w-5xl" id="modalContent">
        <!-- Modal content will be loaded here via JavaScript -->
    </div>
    <label class="modal-backdrop" for="modal">Close</label>
</div>

<div id="trailer-modal" class="trailer-modal" hidden aria-hidden="true">
    <div class="trailer-modal__backdrop" data-modal-close></div>
    <section id="trailer-modal-panel"
             class="trailer-modal__panel"
             role="dialog"
             aria-modal="true"
             aria-labelledby="trailer-modal-title">
        <div class="flex items-center justify-between border-b border-base-300/60 px-4 py-3 bg-base-200/70">
            <h3 id="trailer-modal-title" class="font-semibold truncate pr-3">Movie trailer</h3>
            <button id="trailer-modal-close"
                    type="button"
                    class="btn btn-ghost btn-sm btn-circle"
                    aria-label="Close trailer">
                ✕
            </button>
        </div>
        <div class="h-[calc(100%-3.25rem)] bg-black">
            <iframe id="trailer-modal-iframe"
                    class="w-full h-full"
                    src=""
                    title="Movie trailer"
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen></iframe>
        </div>
    </section>
</div>

<div id="mySegmentedFilter" style="display: none;">
    <div class="msf-track" role="tablist" aria-label="Movie filters">
        <span class="msf-pill" aria-hidden="true"></span>
        <button type="button" class="msf-btn is-active" role="tab" aria-selected="true" data-segment="all">All</button>
        <button type="button" class="msf-btn" role="tab" aria-selected="false" data-segment="scheduled">Scheduled</button>
        <button type="button" class="msf-btn" role="tab" aria-selected="false" data-segment="soldout">Sold Out</button>
        <button type="button" class="msf-btn" role="tab" aria-selected="false" data-segment="completed">Completed</button>
    </div>
</div>

@Html.AntiForgeryToken()

@section Styles {
    <link rel="stylesheet" href="~/css/showtime-timeline.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        window.csrfToken = document.querySelector(
            'input[name="__RequestVerificationToken"]'
        ).value;
    </script>
    <script type="module" src="~/js/AdminTables/Showtime.js" asp-append-version="true"></script>
    <script type="module">
        import { renderTimeline, enterEditMode, exitEditMode, setOnSave } from '/js/showtime-timeline.js';

        const toggleBtns = document.querySelectorAll('#viewToggle .tl-view-tab');
        const toggleTrack = document.getElementById('viewToggle');
        const toggleUnderline = toggleTrack?.querySelector('.tl-view-underline');
        const tableView = document.getElementById('tableView');
        const timelineView = document.getElementById('timelineView');
        const dataTableEl = document.getElementById('DataTable');
        let timelineLoaded = false;

        async function loadTimeline(dateStr, container) {
            container.innerHTML = '<div class="timeline-empty">Loading...</div>';
            let res;
            try {
                res = await fetch(`/Showtime/GetByDate?date=${encodeURIComponent(dateStr)}`);
                if (!res.ok) throw new Error(`Server returned ${res.status}${res.statusText ? ' ' + res.statusText : ''}`);
                const data = await res.json();
                renderTimeline(container, data, dateStr);
            } catch (err) {
                const detail = (err && err.message) ? ` — ${err.message}` : '';
                container.innerHTML = `<div class="timeline-empty text-error">Failed to load timeline${detail}</div>`;
            }
        }

        function getEditModeContainer() {
            return document.getElementById('timelineContainer');
        }

        async function switchView(view) {
            toggleBtns.forEach(b => b.classList.toggle('is-active', b.dataset.view === view));
            const active = toggleTrack?.querySelector('.tl-view-tab.is-active');
            if (toggleUnderline && active) {
                toggleUnderline.style.width = `${active.offsetWidth}px`;
                toggleUnderline.style.left = `${active.offsetLeft}px`;
            }

            if (view === 'table') {
                tableView.classList.remove('hidden');
                timelineView.classList.add('hidden');
                if (dataTableEl && window.$ && window.$.fn.dataTable.isDataTable('#DataTable')) {
                    const api = window.$('#DataTable').DataTable();
                    api.columns.adjust().responsive.recalc();
                }
            } else {
                tableView.classList.add('hidden');
                timelineView.classList.remove('hidden');

                if (!timelineLoaded) {
                    timelineView.innerHTML = `
                        <div class="space-y-4">
                            <div class="flex flex-wrap items-center gap-3">
                                <label class="text-sm font-medium">Date</label>
                                <input type="date" id="timelineDate" class="input input-bordered input-sm w-44"
                                       value="${(() => { const d = new Date(); return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0'); })()}" />
                                <div class="flex-1"></div>
                                <div id="editModeBar" class="flex items-center gap-2 hidden">
                                    <span class="text-xs text-base-content/50">Drag bars to reorder, click + to add, ✕ to delete</span>
                                    <button id="saveBtn" class="btn btn-sm btn-success">Save</button>
                                    <button id="cancelBtn" class="btn btn-sm btn-ghost border border-base-300">Cancel</button>
                                </div>
                                <button id="editBtn" class="btn btn-sm btn-outline">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/></svg>
                                    Edit
                                </button>
                            </div>
                            <div id="timelineContainer" class="bg-base-100 rounded-box border border-base-300 shadow-sm p-4">
                                <div class="timeline-empty">Loading...</div>
                            </div>
                        </div>`;

                    const container = document.getElementById('timelineContainer');
                    const dateInput = document.getElementById('timelineDate');
                    const editBtn = document.getElementById('editBtn');
                    const saveBtn = document.getElementById('saveBtn');
                    const cancelBtn = document.getElementById('cancelBtn');
                    const editModeBar = document.getElementById('editModeBar');
                    const editSvg = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/><path d="m15 5 4 4"/></svg>';

                    function setEditBtnText(text) {
                        editBtn.innerHTML = editSvg + ' ' + text;
                    }

                    function isEditBtnEdit() {
                        return !editBtn.classList.contains('btn-warning');
                    }

                    setOnSave((dateStr) => {
                        setEditBtnText('Edit');
                        editBtn.classList.add('btn-outline');
                        editBtn.classList.remove('btn-warning');
                        editBtn.disabled = false;
                        editModeBar.classList.add('hidden');
                        timelineLoaded = false;
                        loadTimeline(dateStr, container);
                    });

                    editBtn.addEventListener('click', () => {
                        if (isEditBtnEdit()) {
                            enterEditMode(container);
                            setEditBtnText('Exit Edit');
                            editBtn.classList.remove('btn-outline');
                            editBtn.classList.add('btn-warning');
                            editModeBar.classList.remove('hidden');
                        } else {
                            exitEditMode(container);
                            setEditBtnText('Edit');
                            editBtn.classList.add('btn-outline');
                            editBtn.classList.remove('btn-warning');
                            editModeBar.classList.add('hidden');
                        }
                    });

                    saveBtn.addEventListener('click', () => {
                        import('/js/showtime-timeline.js').then(mod => {
                            const wrapper = container.querySelector('.timeline-wrapper');
                            if (wrapper) {
                                const dateStr = dateInput.value;
                                mod.saveChanges(wrapper, dateStr);
                            }
                        });
                    });

                    cancelBtn.addEventListener('click', () => {
                        exitEditMode(container);
                        setEditBtnText('Edit');
                        editBtn.classList.add('btn-outline');
                        editBtn.classList.remove('btn-warning');
                        editModeBar.classList.add('hidden');
                    });

                    loadTimeline(dateInput.value, container);
                    dateInput.addEventListener('change', () => loadTimeline(dateInput.value, container));
                    timelineLoaded = true;
                }
            }
        }

        toggleBtns.forEach(btn => {
            btn.addEventListener('click', () => switchView(btn.dataset.view));
        });

        function initViewToggle() {
            if (!toggleUnderline || !toggleTrack) return;
            const active = toggleTrack.querySelector('.tl-view-tab.is-active');
            if (active) {
                toggleUnderline.style.width = `${active.offsetWidth}px`;
                toggleUnderline.style.left = `${active.offsetLeft}px`;
            }
            toggleBtns.forEach(item => {
                item.addEventListener('mouseenter', () => {
                    toggleUnderline.style.width = `${item.offsetWidth}px`;
                    toggleUnderline.style.left = `${item.offsetLeft}px`;
                });
                item.addEventListener('focus', () => {
                    toggleUnderline.style.width = `${item.offsetWidth}px`;
                    toggleUnderline.style.left = `${item.offsetLeft}px`;
                });
            });
            toggleTrack.addEventListener('mouseleave', () => {
                const activeBtn = toggleTrack.querySelector('.tl-view-tab.is-active');
                if (activeBtn) {
                    toggleUnderline.style.width = `${activeBtn.offsetWidth}px`;
                    toggleUnderline.style.left = `${activeBtn.offsetLeft}px`;
                }
            });
        }
        initViewToggle();
    </script>
}